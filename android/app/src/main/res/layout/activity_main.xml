<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0F1D"
    android:padding="16dp">

    <!-- Header Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI-IDR Mobile Engine"
        android:textColor="#38BDF8"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Telemetry Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:marginTop="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPEED"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="32 km/h"
                android:textColor="#38BDF8"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginStart="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCURACY"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvAccuracyValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="± 0.4 m"
                android:textColor="#10B981"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- GNSS Status -->
    <TextView
        android:id="@+id/tvGnssStatusValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GNSS AVAILABLE"
        android:textColor="#10B981"
        android:textSize="16sp"
        android:textStyle="bold"
        android:marginTop="16dp" />

    <!-- Nav Mode -->
    <TextView
        android:id="@+id/tvNavModeValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GNSS-AIDED NAVIGATION"
        android:textColor="#F8FAFC"
        android:textSize="14sp"
        android:marginTop="4dp" />

    <!-- Confidence -->
    <TextView
        android:id="@+id/tvConfidenceValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="98.5%"
        android:textColor="#38BDF8"
        android:textSize="14sp"
        android:marginTop="4dp" />

</LinearLayout>
